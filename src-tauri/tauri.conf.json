{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByPass Cleaner",
  "version": "1.0.0",
  "identifier": "com.bypass.cleaner",
  "build": {
    "frontendDist": "../webui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByPass Cleaner",
        "width": 1420,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
