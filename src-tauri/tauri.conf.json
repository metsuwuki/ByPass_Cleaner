{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByPass Cleaner",
  "version": "0.3.0",
  "identifier": "com.bypass.cleaner",
  "build": {
    "frontendDist": "../webui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByPass Cleaner",
        "width": 1420,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32.ico",
      "icons/48.ico",
      "icons/64.ico",
      "icons/128.ico",
      "icons/256.ico"
    ]
  }
}
